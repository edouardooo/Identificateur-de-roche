# Modèle des secrets de l'application.
#
# En local : copier ce fichier en « secrets.toml » dans ce même dossier .streamlit
#            et remplacer les valeurs (secrets.toml est ignoré par git, il ne part pas sur GitHub).
# En ligne : coller ces lignes, avec les vraies valeurs, dans Streamlit Cloud :
#            « Manage app » > « Settings » > « Secrets ».
#
# Sans ces secrets, le site fonctionne quand même : seuls l'envoi de photos (Cloudinary)
# et les propositions du dictionnaire (Airtable) sont désactivés.

# Airtable (propositions du dictionnaire)
airtable_token = "patXXXXXXXXXXXXXX.XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
base_id = "appXXXXXXXXXXXXXX"
table_name = "nom de la table"

# Cloudinary (photos ajoutées sur la carte des kayous)
cloudinary_cloud_name = "nom-du-cloud"
cloudinary_api_key = "000000000000000"
cloudinary_api_secret = "XXXXXXXXXXXXXXXXXXXXXXXXXXX"

# Supabase (photothèque) : tableau de bord Supabase > Project Settings > API Keys
# La clé « secret » (sb_secret_…) ou, sur un ancien projet, la clé « service_role ».
# Elle donne tous les droits sur la base : ne jamais la mettre dans le code.
supabase_url = "https://xxxxxxxxxxxxxxxxxxxx.supabase.co"
supabase_secret_key = "sb_secret_XXXXXXXXXXXXXXXXXXXXXXXX"

# Mot de passe de l'onglet Administration (choisis-en un long)
admin_password = "un mot de passe long et unique"
